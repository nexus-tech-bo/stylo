DB_URL=jdbc:postgresql://localhost:5432/stylo
DB_USERNAME=postgres
DB_PASSWORD=
# Base64 HS256 key, at least 64 bytes: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_HOURS=12
# cloudinary://<api_key>:<api_secret>@<cloud_name> (blank = image upload disabled)
CLOUDINARY_URL=
# Safe defaults. For local dev set SEED_DEV_DATA=true, SHOW_SQL=true, SQL_BIND_LOG_LEVEL=TRACE
SEED_DEV_DATA=false
SHOW_SQL=false
# TRACE logs bound SQL parameters (password hashes, PII)
SQL_BIND_LOG_LEVEL=INFO
